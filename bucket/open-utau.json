{
    "$schema": "../scoop/schema.json",
    "homepage": "https://www.openutau.com/",
    "description": "OpenUtau - Open singing synthesis platform / Open source UTAU successor",
    "version": "0.1.576",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/openutau/OpenUtau/releases/download/0.1.576/OpenUtau-win-x64.zip",
            "hash": "475c577f8f42061abc8eef0d6648d772bef87fecd1e81cbf4e82e8a651669c56"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\prefs.json\")) {",
        "    new-item \"$dir\\TVCaptionMod2.ini\" -type file | out-null",
        "}",
        "if (!(Test-Path \"$dir\\prefs.json\")) {",
        "    new-item \"$dir\\prefs.json\" -type file | out-null",
        "}"
    ],
    "persist": [
        "Logs",
        "Plugins",
        "Resamplers",
        "Singers",
        "Templates",
        "Wavtools",
        "prefs.json"
    ],
    "checkver": {
        "github": "https://github.com/openutau/OpenUtau"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openutau/OpenUtau/releases/download/$version/OpenUtau-win-x64.zip"
            }
        }
    },
    "shortcuts": [
        [
            "OpenUtau.exe",
            "OpenUtau"
        ]
    ]
}
